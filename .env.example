# Copy to .env.local (local) and set the same variables in Vercel/Render (production).
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Never put the service_role key in NEXT_PUBLIC_* variables or in client code.
# This app does not need it: all access goes through the user's session and Row Level Security.
